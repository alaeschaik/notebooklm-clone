# Template for deploy/<env>/secrets.env.
#
# The real files are committed *encrypted*. Never create a plain-text copy in
# the working tree — create it encrypted from the start:
#
#   sops deploy/staging/secrets.env
#
# which opens an editor and writes ciphertext. To read or change one later,
# the same command. Rotating a secret is an ordinary commit: the diff shows
# that a value changed and who changed it, but not what it is.
#
# Decryption needs the age identity in /opt/notebook/keys/age.key, which
# exists only on the deployment server and on the operator's machine.

POSTGRES_PASSWORD=          # openssl rand -base64 32
SESSION_SECRET=             # openssl rand -base64 32
METRICS_TOKEN=              # openssl rand -hex 24, guards /api/metrics

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Copy to .env beside the environment directory on the server — one per
# environment, e.g. deploy/staging/.env and deploy/production/.env.

# Host port this environment listens on. Staging and production differ so both
# run on one machine; the reverse proxy maps hostnames onto them.
APP_PORT=3000

POSTGRES_PASSWORD=change-me
SESSION_SECRET=change-me            # openssl rand -base64 32

ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...

LOG_LEVEL=info

# Guards /api/metrics. The reverse proxy forwards every path on the public
# hostname, so without this the endpoint — route names, traffic, spend — is
# readable by anyone. openssl rand -hex 24
METRICS_TOKEN=change-me

# --- Database -------------------------------------------------------------
# Any Postgres with pgvector. The driver is chosen from this URL: Neon's HTTP
# driver for *.neon.tech, node-postgres otherwise.
# Local (docker compose up -d):
DATABASE_URL="postgresql://notebook:notebook@localhost:5433/notebook"
# Production (Neon):
# DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# --- AI providers ---------------------------------------------------------
# Claude powers grounded chat (Citations API), studio documents and mind maps.
ANTHROPIC_API_KEY="sk-ant-..."
# Gemini does two jobs: embeddings for retrieval (gemini-embedding-001) and the
# two-host Audio Overview (multi-speaker TTS). Both are on the free tier.
# Without it, sources still ingest and retrieval falls back to full-text only.
GEMINI_API_KEY="..."

# --- Storage --------------------------------------------------------------
# Vercel Blob holds uploaded documents and rendered audio.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- App ------------------------------------------------------------------
# Random 32+ char string used to sign the anonymous visitor session cookie.
SESSION_SECRET="change-me-to-a-long-random-string"

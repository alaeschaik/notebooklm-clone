# --- Database -------------------------------------------------------------
# Neon Postgres connection string (pgvector extension is enabled by migration).
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# --- AI providers ---------------------------------------------------------
# Claude powers grounded chat (Citations API), studio documents and mind maps.
ANTHROPIC_API_KEY="sk-ant-..."
# OpenAI is used only for embeddings (text-embedding-3-small).
OPENAI_API_KEY="sk-..."
# Gemini renders the two-host Audio Overview via multi-speaker TTS.
GEMINI_API_KEY="..."

# --- Storage --------------------------------------------------------------
# Vercel Blob holds uploaded documents and rendered audio.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- App ------------------------------------------------------------------
# Random 32+ char string used to sign the anonymous visitor session cookie.
SESSION_SECRET="change-me-to-a-long-random-string"

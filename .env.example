# Copy to .env and fill in. Next reads .env for local development, and Docker
# Compose reads the same file, so one copy serves both.

# --- Database -------------------------------------------------------------
# Used when running the app directly with `npm run dev`. Under Docker Compose
# the app reaches Postgres over the compose network and this value is ignored.
DATABASE_URL="postgresql://notebook:notebook@localhost:5433/notebook"

# --- AI providers ---------------------------------------------------------
# Claude: grounded chat with citations, studio documents, mind maps, audio
# scripts. Required.
ANTHROPIC_API_KEY="sk-ant-..."

# Gemini: embeddings for retrieval (gemini-embedding-001) and the two-host
# Audio Overview (multi-speaker TTS).
#
# Optional but strongly recommended. Without it, sources still ingest and
# answers still work — retrieval falls back to full-text only, and the audio
# overview is unavailable.
#
# Note: the free tier allows ten text-to-speech requests per DAY. One overview
# is two or three, so enable billing before relying on audio.
GEMINI_API_KEY="..."

# --- App ------------------------------------------------------------------
# Signs the anonymous visitor cookie. Generate with:
#   openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Docker Compose (optional overrides) ----------------------------------
# APP_PORT=3000
# POSTGRES_PORT=5433
# POSTGRES_USER=notebook
# POSTGRES_PASSWORD=notebook
# POSTGRES_DB=notebook

# Template for monitoring/secrets.env, which is committed encrypted:
#
#   sops monitoring/secrets.env
#
# See docs/devops.md → Secrets.

GRAFANA_PASSWORD=

# One per environment, matching METRICS_TOKEN in the two deploy secret files.
# up.sh writes them to prometheus/metrics-token.<env>, because Prometheus
# reads the credential from a file rather than from its environment.
METRICS_TOKEN_STAGING=
METRICS_TOKEN_PRODUCTION=

# One per environment; each exporter sits inside that stack's compose network,
# so "postgres" resolves to that environment's database.
POSTGRES_EXPORTER_DSN_PRODUCTION=postgresql://notebook:PASSWORD@postgres:5432/notebook?sslmode=disable
POSTGRES_EXPORTER_DSN_STAGING=postgresql://notebook:PASSWORD@postgres:5432/notebook?sslmode=disable

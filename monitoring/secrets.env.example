# Template for monitoring/secrets.env, which is committed encrypted:
#
#   sops monitoring/secrets.env
#
# See docs/devops.md → Secrets.

GRAFANA_PASSWORD=

# Must match METRICS_TOKEN in deploy/production/secrets.env. up.sh also writes
# it to prometheus/metrics-token, because Prometheus reads the credential from
# a file rather than from its environment.
METRICS_TOKEN=

POSTGRES_EXPORTER_DSN=postgresql://notebook:PASSWORD@host.docker.internal:5433/notebook?sslmode=disable

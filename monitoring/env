# Non-secret monitoring configuration. Confidential values live in
# monitoring/secrets.env, encrypted.
#
# App targets and the probed public URL are in prometheus/prometheus.yml, not
# here — Prometheus does not expand environment variables in its config.

PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3300

GRAFANA_ROOT_URL=http://localhost:3300

# Where the Docker daemon keeps its state, mounted read-only by cAdvisor.
# `docker info --format '{{.DockerRootDir}}'` prints it. Snap packages put it
# outside the usual /var/lib/docker.
DOCKER_ROOT=/var/snap/docker/common/var-lib-docker

# Prometheus runs as this user so it can read the 0600 scrape-credential files
# that up.sh writes. Must match the account that runs up.sh (`id -u`).
MONITORING_UID=1000
MONITORING_GID=1000

# Copy to monitoring/.env

GRAFANA_PASSWORD=change-me
GRAFANA_ROOT_URL=https://grafana.example.com

# Note: app targets and the probed public URL live in
# monitoring/prometheus/prometheus.yml, not here — Prometheus does not expand
# environment variables in its configuration.

# Must match METRICS_TOKEN in the app's env file. Also write it to
# monitoring/prometheus/metrics-token — Prometheus reads the file, so the token
# never appears in a process listing.
METRICS_TOKEN=change-me

POSTGRES_EXPORTER_DSN=postgresql://notebook:change-me@host.docker.internal:5432/notebook?sslmode=disable

PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3300
